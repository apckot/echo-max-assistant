# Provision the required credentials and role-specific PostgreSQL URLs.
DATABASE_URL_GATEWAY=
DATABASE_URL_WORKER=
DATABASE_URL_DELIVERY=
DATABASE_URL_SCHEDULER=
DATABASE_URL_MIGRATIONS=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=

# Restore starts closed. An operator may set off after the restore procedure.
RESTORE_FENCE=on

# Production foundation echo requires explicit opt-in.
FOUNDATION_ECHO_ENABLED=false

GATEWAY_DB_POOL_SIZE=10
WORKER_CONCURRENCY=10
DELIVERY_CONCURRENCY=5
QUEUE_HARD_LIMIT=100000
WEBHOOK_BODY_LIMIT_BYTES=1048576
WORK_LEASE_MS=60000
WORK_LEASE_RENEW_MS=20000
HANDLER_TIMEOUT_MS=5000
MAX_VOICE_BYTES=26214400
MAX_VOICE_DURATION_MS=1200000

# Scheduler subscription ownership; version is metadata, token is a secret.
MAX_WEBHOOK_SECRET_VERSION=v1
OPS_HEALTH_TOKEN=
PORT=8080

# Canary remains disabled until a dedicated TEST bot and safe recipient are provisioned.
MAX_CANARY_TEST_CONFIRMED=false
MAX_CANARY_TEST_CHAT_ID=
