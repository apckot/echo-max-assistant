{
  "name": "echo-max-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:functional": "vitest run --passWithNoTests tests/functional",
    "build": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "zod": "4.1.11"
  }
}
