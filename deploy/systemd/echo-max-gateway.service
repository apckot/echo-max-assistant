[Unit]
Description=Echo MAX gateway
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/echo-max/gateway.env
ExecStart=/usr/bin/docker run --rm --name echo-max-gateway --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --cap-drop=ALL --security-opt=no-new-privileges --network echo-max --env-file /etc/echo-max/gateway.env --publish 127.0.0.1:8080:8080 echo-max:stage1 gateway
ExecStop=/usr/bin/docker stop --time 65 echo-max-gateway
TimeoutStopSec=70
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
